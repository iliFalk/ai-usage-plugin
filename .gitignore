/target
**/*.rs.bk

# Sandbox marker, not part of the project.
.ai-jail

# Claude Code local scratch state.
.claude/

# Local secrets — never commit
.env
.env.local
*.credentials.json

# Per-provider config scratch files (config.<provider>.toml) — never commit.
# Only config.example.toml and the user's own config.toml are tracked.
config.*.toml
!config.example.toml

# makepkg build outputs (kept out of the source repo)
packaging/aur/pkg/
packaging/aur/src/
packaging/aur/*.pkg.tar.*
packaging/aur/*.tar.gz
